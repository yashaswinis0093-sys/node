return ( <div className="min-h-screen bg-gradient-to-r from-green-200 to-blue-100 p-6"> <div className="max-w-4xl mx-auto grid gap-6"> {/* Avatar and Welcome */} <Card className="shadow-xl rounded-2xl bg-white"> <CardContent className="flex items-center gap-4 p-6"> <img
src="https://img.icons8.com/color/96/farmer-male.png"
alt="Farmer Avatar"
className="w-20 h-20"
/> <div> <h1 className="text-2xl font-bold text-green-800">Welcome, Student!</h1> <p className="text-gray-600">Your rural learning journey begins 🚀</p> </div> </CardContent> </Card>

{/* Points, Levels, Badges */}
    <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
      <Card className="bg-yellow-50 border-yellow-300">
        <CardContent className="flex flex-col items-center p-6">
          <Star className="text-yellow-500 w-8 h-8" />
          <h2 className="text-xl font-bold mt-2">{points} Points</h2>
          <Button onClick={handleEarnPoints} className="mt-3">Earn 10</Button>
        </CardContent>
      </Card>

      <Card className="bg-blue-50 border-blue-300">
        <CardContent className="flex flex-col items-center p-6">
          <Trophy className="text-blue-600 w-8 h-8" />
          <h2 className="text-xl font-bold mt-2">Level {level}</h2>
          <Progress value={(points / 100) * 100} className="w-full mt-2" />
        </CardContent>
      </Card>

      <Card className="bg-green-50 border-green-300">
        <CardContent className="flex flex-col items-center p-6">
          <Users className="text-green-600 w-8 h-8" />
          <h2 className="text-xl font-bold mt-2">Badges</h2>
          <ul className="text-sm text-gray-700 mt-1 list-disc list-inside">
            {badges.map((b, i) => (
              <li key={i}>{b}</li>
            ))}
          </ul>
        </CardContent>
      </Card>
    </div>

    {/* Leaderboard */}
    <Card className="bg-white shadow-lg">
      <CardContent className="p-6">
        <h2 className="text-xl font-bold text-purple-700 mb-4">🏆 Leaderboard</h2>
        <ol className="list-decimal pl-5 space-y-2 text-gray-700">
          <li>Ravi - 120 pts</li>
          <li>Anita - 110 pts</li>
          <li>You - {points} pts</li>
          <li>Kiran - 30 pts</li>
        </ol>
      </CardContent>
    </Card>
  </div>
</div>

); }

