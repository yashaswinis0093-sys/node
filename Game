import { useState } from "react"; import { Card, CardContent } from "@/components/ui/card"; import { Button } from "@/components/ui/button"; import { Progress } from "@/components/ui/progress"; import { Trophy, Star, Users } from "lucide-react";

export default function Dashboard() { const [points, setPoints] = useState(50); const [level, setLevel] = useState(1); const [badges, setBadges] = useState(["Starter", "Quiz Champ"]);

